# ── Proxy (BrightData) ─────────────────────────────────────────
# Optional. If disabled, the scraper connects directly.
PROXY_ENABLED=false
BRIGHTDATA_HOST=
BRIGHTDATA_PORT=
BRIGHTDATA_USER=
BRIGHTDATA_PASS=

# ── AI keys ────────────────────────────────────────────────────
# Read by the pipeline scripts (env.mjs loads system/.env AND
# website/.env.local — put them in either). In CI/Vercel, set these
# as secrets/env vars instead; real env always overrides these files.
OPENROUTER_API_KEY=
FAL_KEY=

# ── Editorial bot (Telegram) ───────────────────────────────────
# Used by the scrape digest + review/feedback loop.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
