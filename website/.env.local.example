# ── AI keys ────────────────────────────────────────────────────
OPENROUTER_API_KEY=
FAL_KEY=

# ── Admin auth ─────────────────────────────────────────────────
# Signs session cookies. MUST be a long random string in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Allowlist of admin users, one per line: username:saltHex:hashHex
# Generate a line: node system/scripts/hash-password.mjs <username> <password>
# If left empty, falls back to the single dev pair below (admin / password).
ADMIN_USERS=

# Single-user dev fallback (used only when ADMIN_USERS is empty).
ADMIN_USER=admin
ADMIN_PASSWORD=password

# ── Content store location ─────────────────────────────────────
# Path to the content root, relative to the Next app (website/).
# Local dev: ../system/content
# On Vercel the content is bundled via next.config outputFileTracingIncludes,
# and paths auto-resolve — you can leave this unset there.
SCRAPER_BASE_PATH=../system/content
